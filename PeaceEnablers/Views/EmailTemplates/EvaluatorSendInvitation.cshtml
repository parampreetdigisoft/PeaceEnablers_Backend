@model PeaceEnablers.Views.EmailModels.EmailInvitationSendRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>

<body style="margin:0;padding:0;background:#F5F7F9;font-family:'Poppins', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background:#F5F7F9;padding:30px 0;">
        <tr>
            <td align="center">

                <!-- MAIN CARD -->
                <table width="100%" cellpadding="0" cellspacing="0" style="max-width:720px;margin:0 auto;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0px 10px 30px rgba(0,0,0,0.08);">

                    <!-- HEADER -->
                    <tr>
                        <td style="background:#003160;height:6px;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td style="background:#77BD3E;height:3px;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td align="center" style="background:#ffffff;padding:28px 40px 6px;">
                            <img src="@($"{Model.ApiUrl}/assets/images/pem.png")"
                                 alt="PeaceMappers"
                                 width="240"
                                 style="display:block;width:240px;max-width:100%;height:auto;margin:0 auto;border:0;" />
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="background:#ffffff;padding:10px 40px 22px;border-bottom:1px solid #E4E4E4;">
                            <div style="font-size:24px;font-weight:600;color:#003160;text-align:center;line-height:1.35;">
                                @Model.Title
                            </div>
                        </td>
                    </tr>

                    <!-- CONTENT -->
                    <tr>
                        <td style="padding:35px 40px 25px;font-size:15px;color:#2C2C2C;line-height:1.7;">

                            <p style="margin:0 0 18px;">@Model.Name,</p>

                            <p style="margin:0 0 18px;">
                                Your evaluator account for the <strong>Peace Enablers Matrix (PEM)</strong> platform has been activated.
                                You have been added to the evaluation workspace for the countries assigned to you and may now begin reviewing submissions from the analysts.
                            </p>

                            <p style="margin:0 0 18px;">
                                Please use the secure link below to create your password and access your evaluator dashboard:
                            </p>

                            <!-- BUTTON -->
                            <div style="text-align:center;margin:20px 0 20px;">
                                <a href="@Model.ResetPasswordUrl"
                                   style="display:inline-block;padding:14px 20px;background:#003160;color:#ffffff;font-size:16px;border-radius:8px;font-weight:600;text-decoration:none;">
                                    Set Your Password
                                </a>
                            </div>

                            <p style="margin:0 0 16px;"><strong>As an evaluator, you will be able to:</strong></p>

                            <div style="margin:20px 0;padding:18px;background:#F7F7F7;border-left:4px solid #77BD3E;border-radius:6px;color:#003160;font-size:14px;">
                                • Review country assessment inputs submitted by analysts<br />
                                • Score indicators and provide required narrative comments<br />
                                • Coordinate directly with analysts for each assigned country<br />
                                • Submit your completed evaluations for administrative review
                            </div>

                            <p style="margin:0 0 18px;">
                                If you already have an active password, simply log in and proceed with your evaluation tasks.
                            </p>

                            <p style="margin:0 0 18px;">
                                For support or technical issues, please contact
                                <a href="mailto:@Model.Mail" style="color:#003160;text-decoration:none;font-weight:600;">
                                    @Model.Mail
                                </a>.
                            </p>
                            <p style="margin:0 0 18px;">
                                Thank you for contributing to the Peace Enablers Matrix evaluation process.
                            </p>

                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="padding:25px 40px 35px;text-align:left;background:#F7F7F7;font-size:14px;color:#525856;border-top:1px solid #E4E4E4;">
                            <p style="margin:6px 0;color:#003160;">Warm regards,</p>
                            <p style="margin:6px 0;color:#003160;font-weight:600;">
                                <strong>Peace Enablers Matrix – Platform Administration</strong>
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
